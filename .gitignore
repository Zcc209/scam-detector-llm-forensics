# 虛擬環境（包含 .venv 與 venv）
.venv/
.venv312/
venv/
ENV/

# Python 快取與編譯暫存檔
__pycache__/
*.py[cod]
*$py.class

# 產出目錄與測試圖表
artifacts/
*.png
*.jpg
*.jpeg
# 例外：示範／自我檢查用的截圖與文件中的流程圖要提交
!data/demo/*.png
!data/demo/*.jpg
!docs/*.png

# 機密與身分憑證（絕對不可上傳）
*-storage.json
instagram-storage.json
facebook-storage.json
.env
.env.*
*.pem

# 編輯器與 IDE 設定檔
.vscode/
.idea/

# 模型權重資料夾（超過 GitHub 單檔/總量限制，改用雲端連結分享）
anti_fraud_E3_macbert/
*.safetensors
*.bin

# 系統產出的推論 JSON 報告 (避免在根目錄測試時殘留)
report.json

# 作業系統雜湊與暫存檔 (Windows / macOS)
Thumbs.db
desktop.ini
.DS_Store

# 競賽版：微調權重與本機設定不進版控（融合模型 models/fusion_model*.json 要提交）
models/macbert_social/

# 只留在本機、不上傳 GitHub 的文件（版本比較、內部流程、週報）
local_only/

# 本機執行紀錄（分析結果、截圖、log）一律不上傳；程式的輸出都在 artifacts/
*.log
*.stderr
*.stdout
